# Opsis: laptop settings (Windows with Docker Desktop, or any single machine).
# Copy to .env, then run: docker compose up -d
# Open http://localhost:8080. No sign-in: you are the built-in admin.
# A bad value stops the stack once, with the reason in: docker compose logs config-check

DEPLOY_MODE=local
COMPOSE_PROFILES=
APP_NAME=Opsis

# ---- Access -----------------------------------------------------------------
# AUTH_MODE=none and MCP_AUTH=none are only accepted on a loopback address.
AUTH_MODE=none
MCP_AUTH=none
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# The address you type. A path here becomes the app's base path.
PUBLIC_BASE_URL=http://localhost:8080
# IPs or CIDR ranges allowed to set X-Forwarded-* headers. Empty: none.
TRUSTED_PROXIES=

# To try sign-in on the laptop: AUTH_MODE=local, MCP_AUTH=token, and the first
# admin below (you choose a new password at the first sign-in).
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# To try sub-path hosting on the laptop (the way the server is set up), use
# these three values instead, then open http://localhost:8088/opsis/
#   COMPOSE_PROFILES=proxytest
#   PUBLIC_BASE_URL=http://localhost:8088/opsis
#   TRUSTED_PROXIES=172.16.0.0/12

# ---- Features ---------------------------------------------------------------
JOB_RUNNER=inline
FEATURE_SCHEDULED_REFRESH=false
FEATURE_PUBLIC_SHARE_LINKS=false
FEATURE_EMAIL=false
FEATURE_BACKUPS=false
FEATURE_ASSISTANT=true
ASSISTANT_PROVIDER=ollama
# Ollama on this machine, with a model that can call tools.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
# Context size asked for with each request (at least 16384).
OLLAMA_NUM_CTX=32768
# Ollama is offered while ASSISTANT_PROVIDER=ollama; set OLLAMA_ENABLED=false to hide it.
# You can also add your own Anthropic or OpenAI keys on the Account page. Or give the
# workspace a Claude key (ASSISTANT_PROVIDER=anthropic makes it the default):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Backups (FEATURE_BACKUPS=true): one file per backup in the backups volume, on this
# cron schedule (workspace time), keeping the newest BACKUP_RETENTION.
BACKUP_SCHEDULE=30 2 * * *
BACKUP_RETENTION=7

# Email (FEATURE_EMAIL=true) needs a mail server. It only does anything with
# sign-in on (AUTH_MODE=local): invitations, password resets, emailed dashboards.
SMTP_HOST=
SMTP_PORT=587
# starttls, ssl or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# For example: Opsis <you@example.org>
SMTP_FROM=

# ---- Calendar ---------------------------------------------------------------
# Used for relative date ranges, week grains and financial-year grains.
WORKSPACE_TIMEZONE=Australia/Melbourne
WEEK_START=monday
FISCAL_YEAR_START_MONTH=7
# fy_end_year shows "FY2027"; year_span shows "2026-27".
FISCAL_YEAR_LABEL=fy_end_year

# ---- Data -------------------------------------------------------------------
MAX_UPLOAD_MB=200
# How many snapshots of each dataset to keep (minimum 2).
SNAPSHOT_RETENTION=3
# Limits for one query: seconds before it is stopped, rows returned, memory used.
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=10000
QUERY_MEMORY_LIMIT_MB=1024

# ---- Secrets ----------------------------------------------------------------
# Database for metadata only. It is never published outside Docker.
POSTGRES_USER=opsis
POSTGRES_PASSWORD=opsis-local-only
POSTGRES_DB=opsis
# Encrypts saved connection passwords. Leave empty on a laptop: a key is
# generated on first start and kept in the opsisdata volume.
ENCRYPTION_KEY=
