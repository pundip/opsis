# Opsis: server settings (Ubuntu LXC on Proxmox with Docker Engine).
# Copy to .env, change every value marked CHANGE, then run: docker compose up -d
# Invalid combinations stop the api container at startup with a clear message
# (see: docker compose logs api).

DEPLOY_MODE=server
# Add "tunnel" for Cloudflare Tunnel: COMPOSE_PROFILES=server,tunnel
COMPOSE_PROFILES=server
APP_NAME=Opsis

# ---- Access -----------------------------------------------------------------
AUTH_MODE=full
MCP_AUTH=token
# CHANGE: the public https address users type. Used for OAuth redirects and share links.
PUBLIC_BASE_URL=https://bi.example.com
# What Caddy serves. ":80" is plain HTTP, for use behind Cloudflare Tunnel or
# another TLS proxy. Set it to your domain (bi.example.com) for automatic HTTPS.
SITE_ADDRESS=:80
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# The api container is also published on the server's loopback for diagnostics.
# Keep this at 127.0.0.1: Caddy is the only public entry point.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Only with the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Features ---------------------------------------------------------------
JOB_RUNNER=worker
FEATURE_SCHEDULED_REFRESH=true
FEATURE_PUBLIC_SHARE_LINKS=true
FEATURE_EMAIL=false
FEATURE_SQL_LAB=false
FEATURE_BACKUPS=true
FEATURE_ASSISTANT=true
ASSISTANT_PROVIDER=anthropic

# ---- Calendar ---------------------------------------------------------------
WORKSPACE_TIMEZONE=Australia/Melbourne
WEEK_START=monday
FISCAL_YEAR_START_MONTH=7

# ---- Database (metadata only, never published outside Docker) ----------------
POSTGRES_USER=opsis
# CHANGE before the first start. Changing it later needs a manual ALTER ROLE.
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_DB=opsis
