# Opsis: server settings (Ubuntu LXC on Proxmox with Docker Engine, behind
# your existing reverse proxy).
# Copy to .env and set every value marked CHANGE, then run: docker compose up -d
# The stack refuses to start while a CHANGE value is still a placeholder.
# The reason is shown in: docker compose logs config-check

DEPLOY_MODE=server
# server = worker container. Optional extras: caddy (bundled proxy), tunnel, ollama.
COMPOSE_PROFILES=server
APP_NAME=Opsis

# ---- Access -----------------------------------------------------------------
AUTH_MODE=full
MCP_AUTH=token
# CHANGE: the public address, including the sub-path if there is one. The app
# derives its base path (/opsis) from it. Used for routing, OAuth redirects,
# share links and MCP URLs.
PUBLIC_BASE_URL=https://example.com/opsis
# CHANGE: the IP of your reverse proxy (or a CIDR range). Forwarded headers are
# accepted from here and ignored from anywhere else.
TRUSTED_PROXIES=
# CHANGE: the interface the api is published on. Use the LXC's LAN IP so your
# reverse proxy can reach it, and add an LXC firewall rule that only allows
# the proxy's IP on HTTP_PORT. 0.0.0.0 means every interface of the LXC.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080

# Only with the caddy profile (installs without their own reverse proxy).
SITE_ADDRESS=:80
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Only with the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Features ---------------------------------------------------------------
JOB_RUNNER=worker
FEATURE_SCHEDULED_REFRESH=true
FEATURE_PUBLIC_SHARE_LINKS=true
FEATURE_EMAIL=false
FEATURE_SQL_LAB=false
FEATURE_BACKUPS=true
FEATURE_ASSISTANT=true
ASSISTANT_PROVIDER=anthropic

# ---- Calendar ---------------------------------------------------------------
WORKSPACE_TIMEZONE=Australia/Melbourne
WEEK_START=monday
FISCAL_YEAR_START_MONTH=7
# fy_end_year shows "FY2027"; year_span shows "2026-27".
FISCAL_YEAR_LABEL=fy_end_year

# ---- Data -------------------------------------------------------------------
# Raise your reverse proxy's request body limit to match.
MAX_UPLOAD_MB=200
SNAPSHOT_RETENTION=3

# ---- Secrets ----------------------------------------------------------------
POSTGRES_USER=opsis
# CHANGE before the first start: at least 12 characters, unique to this install.
# Changing it later needs a manual ALTER ROLE in Postgres.
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_DB=opsis
# CHANGE: encrypts saved connection passwords. Generate one with:
#   docker compose run --rm --no-deps api generate-key
# Keep a copy somewhere safe. Without it, saved connection secrets cannot be read.
ENCRYPTION_KEY=
