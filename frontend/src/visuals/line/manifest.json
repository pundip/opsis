{
  "id": "line",
  "name": "Line chart",
  "version": "1.0.0",
  "description": "Show how a measure changes over time or along an ordered dimension.",
  "roles": {
    "x": { "kind": "dimension", "min": 1, "max": 1, "label": "X axis" },
    "y": { "kind": "measure", "min": 1, "max": 5, "label": "Values" },
    "series": { "kind": "dimension", "min": 0, "max": 1, "label": "Split by" }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "smooth": { "title": "Smooth lines", "type": "boolean", "default": false },
      "showMarkers": { "title": "Show point markers", "type": "boolean", "default": false }
    }
  },
  "aiHints": "The default for trends over time: bind a time dimension with a grain (month is a good start) to x. Use Split by for up to about 6 lines; more than that is unreadable.",
  "defaultSize": { "w": 6, "h": 7 },
  "minSize": { "w": 3, "h": 4 },
  "capabilities": { "crossFilter": false, "drillDown": true }
}
