{
  "id": "area",
  "name": "Area chart",
  "version": "1.0.0",
  "description": "A line chart with the area below filled, to show volume over time.",
  "roles": {
    "x": { "kind": "dimension", "min": 1, "max": 1, "label": "X axis" },
    "y": { "kind": "measure", "min": 1, "max": 5, "label": "Values" },
    "series": { "kind": "dimension", "min": 0, "max": 1, "label": "Split by" }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stacked": { "title": "Stacked", "type": "boolean", "default": true },
      "smooth": { "title": "Smooth lines", "type": "boolean", "default": false }
    }
  },
  "aiHints": "Use stacked area to show how parts make up a total over time. Prefer line when the individual series matter more than the total.",
  "defaultSize": { "w": 6, "h": 7 },
  "minSize": { "w": 3, "h": 4 },
  "capabilities": { "crossFilter": false, "drillDown": true }
}
