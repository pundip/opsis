{
  "id": "table",
  "name": "Table",
  "version": "1.0.0",
  "description": "Rows and columns, sortable and paginated.",
  "roles": {
    "columns": { "kind": "any", "min": 1, "max": 30, "label": "Columns" }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pageSize": { "title": "Rows per page", "type": "integer", "minimum": 5, "maximum": 200, "default": 15 },
      "conditionalFormatting": {
        "title": "Conditional formatting",
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator", "value"],
          "properties": {
            "field": { "title": "Column (field reference)", "type": "string", "minLength": 3 },
            "operator": { "title": "When the value is", "enum": ["gt", "gte", "lt", "lte", "eq"], "default": "gt" },
            "value": { "title": "Than", "type": "number" },
            "style": { "title": "Show as", "enum": ["good", "bad", "highlight"], "default": "highlight" }
          }
        }
      }
    }
  },
  "aiHints": "Use when exact values matter or there are many columns. Columns can be dimensions and measures in any order. Dimension columns group the rows; measures are aggregated per group. Set sort and limit on the item.",
  "defaultSize": { "w": 12, "h": 8 },
  "minSize": { "w": 3, "h": 4 },
  "capabilities": { "crossFilter": true, "drillDown": false }
}
