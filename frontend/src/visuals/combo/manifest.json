{
  "id": "combo",
  "name": "Combo chart",
  "version": "1.0.0",
  "description": "Bars and lines together on one shared axis.",
  "roles": {
    "category": { "kind": "dimension", "min": 1, "max": 1, "label": "Category" },
    "bars": { "kind": "measure", "min": 1, "max": 3, "label": "Bars" },
    "lines": { "kind": "measure", "min": 1, "max": 3, "label": "Lines" }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stacked": { "title": "Stack the bars", "type": "boolean", "default": false },
      "smooth": { "title": "Smooth lines", "type": "boolean", "default": false }
    }
  },
  "aiHints": "Bars and lines share one value axis, so only combine measures in the same unit and of similar size (for example actual as bars and target as a line). For measures of different scale use two separate charts.",
  "defaultSize": { "w": 6, "h": 7 },
  "minSize": { "w": 3, "h": 4 },
  "capabilities": { "crossFilter": true, "drillDown": true }
}
